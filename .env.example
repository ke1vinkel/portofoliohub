# Application database used for portfolios, projects, profiles, and messages.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Optional: Space-separated extra domains allowed to embed this app in an iframe/sideapp
# Example: ALLOWED_FRAME_ANCESTORS="http://localhost:3000 https://your-portal-domain.com"
ALLOWED_FRAME_ANCESTORS="http://localhost:3000"

# Main Portal App URL (for redirecting direct visitors to the portal)
NEXT_PUBLIC_PORTAL_URL="http://localhost:3000"

# NextAuth / Session Secret
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"
